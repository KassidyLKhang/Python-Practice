def draw(t, length, n):
    if n == 0:
        return
    
    angle = 50
    t.fd(length*n)
    t.lt(angle) #Travel length * 2 and turn 50

    draw(t, length, n-1)

    t.rt(2*angle) #Turn 100

    draw(t, length, n-1)

    t.lt(angle)
    t.bk(length*n) #Turn 50 and back up length * 2  


